@startuml UML用例图
skinparam defaultFontName "Microsoft YaHei"
left to right direction
skinparam packageStyle rectangle

actor "访客" as Guest
actor "登录用户" as User
actor "买家" as Buyer
actor "卖家" as Seller
actor "平台管理员" as Admin

User --|> Guest
Buyer --|> User
Seller --|> User

rectangle "二手交易系统" {
  usecase "UC01 注册与登录" as UC01
  usecase "UC02 查询商品" as UC02
  usecase "UC03 发起预约" as UC03
  usecase "UC04 取消预约" as UC04
  usecase "UC05 查看我的预约与交易" as UC05
  usecase "UC06 商品草稿与提交审核" as UC06
  usecase "UC07 修改已发布商品" as UC07
  usecase "UC08 主动下架与重新上架" as UC08
  usecase "UC09 确认预约" as UC09
  usecase "UC10 标记交易完成" as UC10
  usecase "UC11 审核商品" as UC11
  usecase "UC12 违规下架与处理申诉" as UC12
  usecase "UC13 封禁与解封用户" as UC13
  usecase "UC14 查看统计" as UC14
  usecase "UC15 查询操作日志" as UC15
  usecase "UC16 查看站内通知" as UC16
  usecase "UC17 买家确认交易" as UC17
  usecase "UC18 校验商品状态与预约唯一性" as UC18
}

Guest --> UC01

Buyer --> UC02
Buyer --> UC03
Buyer --> UC04
Buyer --> UC05
Buyer --> UC16
Buyer --> UC17

Seller --> UC05
Seller --> UC06
Seller --> UC07
Seller --> UC08
Seller --> UC09
Seller --> UC10
Seller --> UC16

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

UC03 ..> UC18 : <<include>>
UC04 ..> UC18 : <<include>>
UC09 ..> UC18 : <<include>>
UC10 ..> UC18 : <<include>>
UC07 ..> UC11 : <<include>> 重新审核
UC08 ..> UC11 : <<include>> 重新审核

@enduml
